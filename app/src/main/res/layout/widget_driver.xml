<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="PITWALL" android:textStyle="bold" android:letterSpacing="0.12" android:textSize="11sp" android:textColor="#F8F9FC" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● LIVE DATA" android:textSize="9sp" android:textColor="#FF8C26" />
    </LinearLayout>
    <View android:layout_width="44dp" android:layout_height="3dp" android:background="#FF8C26" android:layout_marginTop="11dp" android:layout_marginBottom="10dp"/>
    <TextView android:id="@+id/widgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FAVOURITE DRIVER" android:textColor="#FF8C26" android:textStyle="bold" android:letterSpacing="0.08" android:textSize="11sp" android:maxLines="1" />
    <TextView android:id="@+id/widgetMain" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="Updating…" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="21sp" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/widgetSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DRIVERS' CHAMPIONSHIP · 2026" android:textColor="#C1CBD8" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>